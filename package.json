{
  "name": "portfolio-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd fastapi_backend && uvicorn main:app --reload --port 5000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint ./src --ext .js,.jsx || true",
    "format": "prettier --write ."
    ,"analyze": "vite build --mode production && rollup -i dist/assets/index.*.js -p @rollup/plugin-visualizer --file stats.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "framer-motion": "^11.0.3",
    "axios": "^1.6.7",
    "recharts": "^2.12.0",
    "lucide-react": "^0.324.0",
    "react-dropzone": "^14.2.3",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "pg": "^8.11.3",
    "multer": "^1.4.5-lts.1",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.1",
    "yahoo-finance2": "^2.11.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.0",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.35",
    "autoprefixer": "^10.4.17",
    "nodemon": "^3.0.3",
    "concurrently": "^8.2.0"
  }
}
